generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus{
  PENDING
  CONFIRMED
  CANCELLED
}

model Passenger{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  bookings Booking[]
}

model Bus{
  id                 Int    @id @default(autoincrement())
  name               String
  registrationNumber String @unique

  seats Seat[]
  trips Trip[]
}

model Seat{
  id           Int            @id @default(autoincrement())
  busId        Int
  seatNumber   String

  bus          Bus            @relation(field: [busID], references: [id])
  bookingSeats BookingSeat[]

  @@unique([busId, seatNumber])
}

model Trip{
  id            Int             @id @default(autoincrement())
  busId         Int
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  fare          Float

  bus           Bus             @relation(fields: [busId], references: [id])
  bookings      Booking[]
  bookingSeats  BookingSeats[]
}


