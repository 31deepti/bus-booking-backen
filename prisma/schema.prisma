generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus{
  PENDING
  CONFIRMED
  CANCELLED
}

model Passenger{
  id        Int        @id      @default(autoincrement())
  name      String
  email     String     @unique
  bookings  Booking[]
}

model Bus{
  id                 Int    @id @default(autoincrement())
  name               String
  registrationNumber String @unique

  seats Seat[]
  trips Trip[]
}

model Seat{
  id           Int            @id @default(autoincrement())
  busId        Int
  seatNumber   String

  bus          Bus            @relation(field: [busID], references: [id])
  bookingSeats BookingSeat[]

  @@unique([busId, seatNumber])
}

model Trip{
  id            Int             @id @default(autoincrement())
  busId         Int
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  fare          Float

  bus           Bus             @relation(fields: [busId], references: [id])
  bookings      Booking[]
  bookingSeats  BookingSeats[]
}

model Booking{
  id             Int             @id    @default(autoincrement())
  passengerId    Int
  tripId         Int
  status         BookingStatus           @default(PENDING)
  createdAt      DateTime                @default(now())

  passenger      Passenger       @relation(field: [passengerId],references: [id])
  trip           Trip            @relation(fields: [tripId], references: [id])
  seats          BookingSeat[]
}

model BookingSeat{
  id              Int       @default(autoincrement())
  tripId          Int
  bookingId       Int
  seatId          Int

  trip            Trip      @relation(fields: [tripId], references: [id])
  booking         Booking   @relation(fields:[bookingId], references:[id])
  seat            Seat      @relation(fields: [seatId], references: [id])
}

